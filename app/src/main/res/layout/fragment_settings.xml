<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/tab_settings"
            android:textColor="@color/on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/row_dark_mode"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/row_language"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/row_target_folders"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/row_export_playlist"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/row_import_playlist"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/row_record"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/row_cloud_import"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/row_privacy_policy"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/row_license"
            layout="@layout/item_setting_row" />

    </LinearLayout>
</ScrollView>
