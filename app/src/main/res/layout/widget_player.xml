<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/surface"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_image_art"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_music_note"
        android:background="@color/surface_variant"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:maxLines="1"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_button_previous"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_previous"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_previous" />

    <ImageButton
        android:id="@+id/widget_button_play_pause"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_play"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_play_pause" />

    <ImageButton
        android:id="@+id/widget_button_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_next"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_next" />

</LinearLayout>
